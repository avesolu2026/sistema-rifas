<div class="min-h-screen bg-black">

  <%- include('../partials/admin-header', { tabActiva: 'cuenta' }) %>

  <div class="max-w-md mx-auto px-4 py-8">

    <a href="/admin/rifas" class="text-sm text-white/40 hover:text-white/60">← Volver a mis rifas</a>
    <h1 class="font-display text-2xl font-bold text-white mt-2 mb-6">🔑 Cambiar contraseña</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-950 border border-red-800 text-red-300 text-sm rounded-xl p-3 mb-4">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof exito !== 'undefined' && exito) { %>
      <div class="bg-green-950 border border-green-800 text-green-300 text-sm rounded-xl p-3 mb-4">
        <%= exito %>
      </div>
    <% } %>

    <form action="/admin/cambiar-password" method="POST" class="space-y-4 bg-black rounded-2xl border border-dorado/20 p-6">
      <div>
        <label class="block text-sm font-medium text-white/70">Contraseña actual</label>
        <input type="password" name="passwordActual" required autocomplete="current-password"
               class="mt-1 w-full bg-black border border-dorado/25 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-dorado focus:border-transparent">
      </div>

      <div>
        <label class="block text-sm font-medium text-white/70">Nueva contraseña</label>
        <input type="password" name="passwordNueva" required minlength="8" autocomplete="new-password"
               class="mt-1 w-full bg-black border border-dorado/25 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-dorado focus:border-transparent">
        <p class="text-xs text-white/40 mt-1">Mínimo 8 caracteres.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-white/70">Confirmar nueva contraseña</label>
        <input type="password" name="confirmarPassword" required minlength="8" autocomplete="new-password"
               class="mt-1 w-full bg-black border border-dorado/25 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-dorado focus:border-transparent">
      </div>

      <button type="submit"
              class="w-full bg-dorado text-tinta font-display font-semibold py-3 rounded-xl hover:opacity-90 active:scale-[0.98] transition">
        Guardar contraseña
      </button>
    </form>

  </div>
</div>