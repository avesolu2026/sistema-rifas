<div class="min-h-screen bg-black flex items-center justify-center px-4">
  <div class="w-full max-w-sm">

    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-dorado text-tinta text-2xl mb-3">
        🎟️
      </div>
      <h1 class="font-display text-2xl font-bold text-white">Panel administrativo</h1>
      <p class="text-sm text-white/60 mt-1">Ingresa para gestionar tus rifas</p>
    </div>

    <div class="bg-black rounded-2xl border border-dorado/20 p-6">
      <% if (error) { %>
        <div class="bg-red-950 border border-red-800 text-red-300 text-sm rounded-xl p-3 mb-4">
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-white/70 mb-1">Usuario</label>
          <input type="text" name="usuario" required
                 class="w-full bg-black border border-dorado/25 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-dorado focus:border-transparent">
        </div>
        <div>
          <label class="block text-sm font-medium text-white/70 mb-1">Contraseña</label>
          <input type="password" name="password" required
                 class="w-full bg-black border border-dorado/25 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-dorado focus:border-transparent">
        </div>
        <button type="submit"
                class="w-full bg-dorado text-tinta font-display font-semibold py-3 rounded-xl hover:opacity-90 active:scale-[0.98] transition">
          Entrar
        </button>
      </form>
    </div>

  </div>
</div>