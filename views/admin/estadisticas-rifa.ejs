<div class="min-h-screen">

  <%- include('../partials/admin-header', { tabActiva: 'rifas' }) %>

  <div class="max-w-5xl mx-auto px-4 py-8">

    <div class="mb-6">
      <a href="/admin/rifas" class="text-sm text-tinta/40 hover:text-tinta/60">← Volver a mis rifas</a>
      <h1 class="font-display text-2xl font-bold text-tinta mt-2"><%= rifa.titulo %></h1>
      <p class="text-sm text-tinta/50 mt-0.5"><%= stats.total_numeros %> números en total</p>
    </div>

    <!-- Tarjetas de estadísticas -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="bg-white rounded-2xl border border-tinta/5 p-4">
        <p class="text-xs text-tinta/50">Vendidos</p>
        <p class="font-display text-2xl font-bold text-exito mt-1"><%= stats.vendidos %></p>
      </div>
      <div class="bg-white rounded-2xl border border-tinta/5 p-4">
        <p class="text-xs text-tinta/50">Reservados</p>
        <p class="font-display text-2xl font-bold text-dorado mt-1"><%= stats.reservados %></p>
      </div>
      <div class="bg-white rounded-2xl border border-tinta/5 p-4">
        <p class="text-xs text-tinta/50">Disponibles</p>
        <p class="font-display text-2xl font-bold text-tinta/70 mt-1"><%= stats.disponibles %></p>
      </div>
      <div class="bg-white rounded-2xl border border-tinta/5 p-4 col-span-2 sm:col-span-1">
        <p class="text-xs text-tinta/50">Recaudado</p>
        <p class="font-display text-xl font-bold text-boleto mt-1">$<%= Number(stats.recaudado).toLocaleString('es-CO') %></p>
      </div>
    </div>

    <!-- Barra de progreso -->
    <div class="bg-white rounded-2xl border border-tinta/5 p-5 mb-8">
      <div class="flex justify-between text-sm mb-2">
        <span class="text-tinta/60">Progreso de venta</span>
        <span class="font-semibold text-tinta">
          <%= stats.ordenes_aprobadas %> venta<%= stats.ordenes_aprobadas !== 1 ? 's' : '' %> confirmada<%= stats.ordenes_aprobadas !== 1 ? 's' : '' %>
          <% if (stats.ordenes_pendientes > 0) { %>
            <span class="text-dorado">· <%= stats.ordenes_pendientes %> pendiente<%= stats.ordenes_pendientes !== 1 ? 's' : '' %></span>
          <% } %>
        </span>
      </div>
      <div class="w-full bg-tinta/10 rounded-full h-3 overflow-hidden">
        <div class="bg-gradient-to-r from-boleto to-dorado h-3 rounded-full"
             style="width: <%= ((stats.vendidos / stats.total_numeros) * 100).toFixed(1) %>%"></div>
      </div>
    </div>

    <!-- Órdenes -->
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-display font-semibold text-tinta">Órdenes de esta rifa</h2>
      <a href="/admin/rifas/<%= rifa.id %>/exportar"
         class="text-xs font-medium px-3 py-1.5 rounded-lg border border-tinta/10 text-tinta/70 hover:bg-white transition">
        📥 Exportar a Excel
      </a>
    </div>

    <% if (ordenes.length === 0) { %>
      <div class="bg-white rounded-2xl border border-dashed border-tinta/15 p-8 text-center">
        <p class="text-tinta/40 text-sm">Todavía no hay órdenes en esta rifa.</p>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <% ordenes.forEach(o => { %>
          <div class="bg-white rounded-2xl border border-tinta/5 p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-medium text-tinta"><%= o.nombre %></p>
                <div class="flex flex-wrap gap-x-3 text-xs text-tinta/50 mt-0.5">
                  <span>📞 <%= o.telefono %></span>
                  <span>✉️ <%= o.correo %></span>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-tinta"><%= o.numeros.length %> núms · $<%= Number(o.valor_total).toLocaleString('es-CO') %></span>
                <span class="text-xs font-medium px-2 py-1 rounded-full
                  <%= o.estado === 'aprobado' ? 'bg-exito/10 text-exito' :
                      o.estado === 'pendiente' ? 'bg-dorado/15 text-dorado' :
                      'bg-red-50 text-red-500' %>">
                  <%= o.estado %>
                </span>
              </div>
            </div>

            <div class="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-tinta/5">
              <% o.numeros.forEach(n => { %>
                <span class="text-[11px] font-semibold bg-crema text-tinta/70 px-1.5 py-0.5 rounded">
                  <%= String(n).padStart(4, '0') %>
                </span>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>