<div class="min-h-screen">

  <%- include('../partials/admin-header', { tabActiva: 'rifas' }) %>

  <div class="max-w-5xl mx-auto px-4 py-8">

    <div class="mb-6">
      <a href="/admin/rifas" class="text-sm text-tinta/40 hover:text-tinta/60">← Volver a mis rifas</a>
      <h1 class="font-display text-2xl font-bold text-tinta mt-2"><%= rifa.titulo %></h1>
      <p class="text-sm text-tinta/50 mt-0.5"><%= numeros.length %> números en total</p>
    </div>

    <!-- Leyenda -->
    <div class="flex flex-wrap gap-4 mb-5 text-xs">
      <span class="flex items-center gap-1.5 text-tinta/60"><span class="w-3 h-3 rounded bg-tinta/10 inline-block"></span> Disponible</span>
      <span class="flex items-center gap-1.5 text-tinta/60"><span class="w-3 h-3 rounded bg-dorado inline-block"></span> Reservado</span>
      <span class="flex items-center gap-1.5 text-tinta/60"><span class="w-3 h-3 rounded bg-exito inline-block"></span> Vendido</span>
    </div>

    <div class="bg-white rounded-2xl border border-tinta/5 p-4">
      <div class="grid grid-cols-[repeat(auto-fill,minmax(48px,1fr))] gap-1.5">
        <% numeros.forEach(n => { %>
          <span class="text-center text-[11px] font-semibold py-1.5 rounded
            <%= n.estado === 'vendido' ? 'bg-exito/15 text-exito' :
                n.estado === 'reservado' ? 'bg-dorado/20 text-dorado' :
                'bg-tinta/5 text-tinta/40' %>">
            <%= String(n.numero).padStart(4, '0') %>
          </span>
        <% }) %>
      </div>
    </div>

  </div>
</div>