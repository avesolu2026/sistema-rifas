<div class="min-h-screen bg-black">

  <%- include('../partials/admin-header', { tabActiva: 'rifas' }) %>

  <div class="max-w-5xl mx-auto px-4 py-8">

    <!-- Resumen -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-8">
      <div class="bg-black rounded-2xl border border-dorado/20 p-4">
        <p class="text-xs text-white/50">Rifas activas</p>
        <p class="font-display text-2xl font-bold text-white mt-1"><%= stats.activas %></p>
      </div>
      <div class="bg-black rounded-2xl border border-dorado/20 p-4">
        <p class="text-xs text-white/50">Números ocupados</p>
        <p class="font-display text-2xl font-bold text-white mt-1"><%= stats.vendidos %></p>
      </div>
      <div class="bg-black rounded-2xl border border-dorado/20 p-4 col-span-2 sm:col-span-1">
        <p class="text-xs text-white/50">Recaudado</p>
        <p class="font-display text-2xl font-bold text-dorado mt-1">$<%= Number(stats.recaudado).toLocaleString('es-CO') %></p>
      </div>
    </div>

    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-display text-2xl font-bold text-white">Mis rifas</h1>
        <p class="text-sm text-white/50 mt-0.5"><%= rifas.length %> rifa<%= rifas.length !== 1 ? 's' : '' %> creada<%= rifas.length !== 1 ? 's' : '' %></p>
      </div>
      <a href="/admin/rifas/crear"
         class="bg-dorado text-tinta font-display font-semibold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 active:scale-[0.98] transition whitespace-nowrap">
        + Nueva rifa
      </a>
    </div>

    <% if (rifas.length === 0) { %>
      <div class="bg-black rounded-2xl border border-dashed border-dorado/20 p-10 text-center">
        <p class="text-white/40">Todavía no has creado ninguna rifa.</p>
      </div>
    <% } %>

    <div class="grid gap-4">
      <% rifas.forEach(rifa => { %>
        <% const imgs = JSON.parse(rifa.premio_imagenes || '[]'); %>
        <div class="bg-black rounded-2xl border border-dorado/20 overflow-hidden">
          <div class="flex flex-col sm:flex-row">

            <% if (imgs.length > 0) { %>
              <img src="<%= imgs[0] %>" class="w-full sm:w-40 h-40 sm:h-auto object-cover" alt="<%= rifa.titulo %>">
            <% } else { %>
              <div class="w-full sm:w-40 h-40 sm:h-auto bg-white/5 flex items-center justify-center text-3xl">🎁</div>
            <% } %>

            <div class="flex-1 p-4 flex flex-col justify-between">
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-display font-semibold text-white text-lg leading-snug"><%= rifa.titulo %></h2>
                <span class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full
                  <%= rifa.estado === 'activa' ? 'bg-dorado/10 text-dorado' : 'bg-white/5 text-white/50' %>">
                  <%= rifa.estado %>
                </span>
              </div>

              <p class="text-sm text-white/50 mt-1">
                <%= rifa.total_numeros %> números — $<%= Number(rifa.precio_numero).toLocaleString('es-CO') %> c/u
              </p>

              <div class="flex flex-wrap items-start gap-2 mt-3">
                <a href="/admin/rifas/<%= rifa.id %>/estadisticas"
                   class="text-xs font-medium px-3 py-1.5 rounded-lg border border-dorado/20 text-white/70 hover:bg-white/5 transition">
                  📊 Estadísticas
                </a>
                <a href="/admin/rifas/<%= rifa.id %>/numeros"
                   class="text-xs font-medium px-3 py-1.5 rounded-lg border border-dorado/20 text-white/70 hover:bg-white/5 transition">
                  🔢 Ver números
                </a>

                <!-- Ver página: menú con abrir, copiar link y QR -->
                <details>
                  <summary style="list-style:none;cursor:pointer;user-select:none"
                           class="text-xs font-medium px-3 py-1.5 rounded-lg border border-dorado/20 text-white/70 hover:bg-white/5 transition">
                    Ver página ▾
                  </summary>
                  <div style="margin-top:6px;width:11rem"
                       class="rounded-xl border border-dorado/20 bg-black p-1">
                    <a href="/venta-numeros/<%= rifa.id %>" target="_blank"
                       class="block text-xs text-white/80 hover:bg-white/5 rounded-lg px-3 py-2">
                      🌐 Abrir página
                    </a>
                    <button type="button"
                            data-ruta="/venta-numeros/<%= rifa.id %>"
                            onclick="copiarLink(this)"
                            class="block w-full text-left text-xs text-white/80 hover:bg-white/5 rounded-lg px-3 py-2">
                      🔗 Copiar link
                    </button>
                    <button type="button"
                            data-ruta="/venta-numeros/<%= rifa.id %>"
                            data-titulo="<%= rifa.titulo %>"
                            onclick="mostrarQR(this)"
                            class="block w-full text-left text-xs text-white/80 hover:bg-white/5 rounded-lg px-3 py-2">
                      ▦ Ver QR
                    </button>
                  </div>
                </details>

                <a href="/admin/rifas/<%= rifa.id %>/editar"
                   class="text-xs font-medium px-3 py-1.5 rounded-lg border border-dorado/20 text-white/70 hover:bg-white/5 transition">
                  Editar
                </a>
                <form action="/admin/rifas/<%= rifa.id %>/eliminar" method="POST"
                      onsubmit="return confirm('¿Eliminar esta rifa? Esta acción no se puede deshacer.');">
                  <button type="submit"
                          class="text-xs font-medium px-3 py-1.5 rounded-lg border border-red-900 text-red-400 hover:bg-red-950 transition">
                    Eliminar
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</div>

<!-- Ventana del QR -->
<div id="qr-modal"
     style="display:none;position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.8);align-items:center;justify-content:center;padding:16px"
     onclick="if (event.target === this) cerrarQR()">
  <div style="background:#fff;color:#111;border-radius:16px;padding:24px;max-width:340px;width:100%;text-align:center">
    <h3 id="qr-titulo" style="font-weight:700;font-size:18px;margin-bottom:4px"></h3>
    <p style="font-size:12px;color:#666;margin-bottom:16px">Escanea para comprar tus números</p>
    <div id="qr-contenedor" style="display:flex;justify-content:center;margin-bottom:12px"></div>
    <p id="qr-link" style="font-size:11px;color:#888;word-break:break-all;margin-bottom:16px"></p>
    <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
      <button type="button" onclick="imprimirQR()"
              style="background:#111;color:#fff;border-radius:10px;padding:8px 14px;font-size:13px;font-weight:600">
        🖨️ Imprimir
      </button>
      <button type="button" onclick="descargarQR()"
              style="background:#eee;color:#111;border-radius:10px;padding:8px 14px;font-size:13px;font-weight:600">
        ⬇️ Descargar
      </button>
      <button type="button" onclick="cerrarQR()"
              style="background:#eee;color:#111;border-radius:10px;padding:8px 14px;font-size:13px;font-weight:600">
        Cerrar
      </button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
  let qrActual = { url: '', titulo: '' };

  function urlCompleta(ruta) {
    return window.location.origin + ruta;
  }

  function copiarLink(btn) {
    const url = urlCompleta(btn.dataset.ruta);
    const textoOriginal = btn.textContent;

    function listo() {
      btn.textContent = '✅ ¡Link copiado!';
      setTimeout(function () { btn.textContent = textoOriginal; }, 1500);
    }

    function copiarConRespaldo() {
      const t = document.createElement('textarea');
      t.value = url;
      document.body.appendChild(t);
      t.select();
      document.execCommand('copy');
      t.remove();
      listo();
    }

    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(url).then(listo).catch(copiarConRespaldo);
    } else {
      copiarConRespaldo();
    }
  }

  function mostrarQR(btn) {
    const url = urlCompleta(btn.dataset.ruta);
    qrActual = { url: url, titulo: btn.dataset.titulo || 'Rifa' };

    document.getElementById('qr-titulo').textContent = qrActual.titulo;
    document.getElementById('qr-link').textContent = url;

    const cont = document.getElementById('qr-contenedor');
    cont.innerHTML = '';
    new QRCode(cont, {
      text: url,
      width: 260,
      height: 260,
      correctLevel: QRCode.CorrectLevel.H
    });

    document.getElementById('qr-modal').style.display = 'flex';

    const menu = btn.closest('details');
    if (menu) menu.removeAttribute('open');
  }

  function cerrarQR() {
    document.getElementById('qr-modal').style.display = 'none';
  }

  function obtenerQRDataUrl() {
    const canvas = document.querySelector('#qr-contenedor canvas');
    return canvas ? canvas.toDataURL('image/png') : null;
  }

  function descargarQR() {
    const dataUrl = obtenerQRDataUrl();
    if (!dataUrl) return;
    const nombre = qrActual.titulo.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const a = document.createElement('a');
    a.href = dataUrl;
    a.download = 'qr-' + (nombre || 'rifa') + '.png';
    a.click();
  }

  function escaparHtml(texto) {
    return String(texto).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function imprimirQR() {
    const dataUrl = obtenerQRDataUrl();
    if (!dataUrl) return;

    const w = window.open('', '_blank');
    if (!w) {
      alert('El navegador bloqueó la ventana de impresión. Permite las ventanas emergentes e inténtalo de nuevo.');
      return;
    }

    w.document.write(
      '<!DOCTYPE html><html><head><title>QR - ' + escaparHtml(qrActual.titulo) + '</title>' +
      '<style>' +
      'body{font-family:Arial,sans-serif;text-align:center;margin:0;padding:40px}' +
      'h1{font-size:32px;margin:0 0 8px}' +
      'p{font-size:16px;color:#444;margin:0 0 24px}' +
      'img{width:420px;height:420px}' +
      '.link{font-size:14px;color:#666;margin-top:16px;word-break:break-all}' +
      '</style></head><body>' +
      '<h1>' + escaparHtml(qrActual.titulo) + '</h1>' +
      '<p>Escanea el código y compra tus números</p>' +
      '<img src="' + dataUrl + '" onload="window.print()">' +
      '<div class="link">' + escaparHtml(qrActual.url) + '</div>' +
      '</body></html>'
    );
    w.document.close();
  }
</script>