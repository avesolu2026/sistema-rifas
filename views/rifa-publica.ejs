<style>
  .boleto-card { position: relative; }
  .boleto-card::before, .boleto-card::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    background: #1C1633;
    border-radius: 50%;
    z-index: 10;
  }
  .boleto-card::before { left: -9px; }
  .boleto-card::after { right: -9px; }

  .carrusel::-webkit-scrollbar { display: none; }
  .carrusel { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="min-h-screen pb-28 sm:pb-12 bg-tinta">

  <!-- Banner llamativo de venta -->
  <div class="bg-dorado text-tinta text-center py-3 px-4">
    <p class="font-display text-xl sm:text-3xl font-extrabold uppercase tracking-wide">
      🔥 PRISMA BY KEKU'S 🔥
    </p>
  </div>

  <!-- Header con título del premio -->
  <div class="text-center py-8 px-4 border-b border-dorado/20">
    <p class="text-xs uppercase tracking-wider text-dorado font-semibold mb-2">🎟️ Rifa activa</p>
    <h1 class="font-display text-2xl sm:text-4xl font-bold leading-tight text-white"><%= rifa.titulo %></h1>
    <p class="mt-2 text-white/60 text-sm sm:text-base">🫵 ¡Todo esto puede ser tuyo!</p>
  </div>

  <!-- Galería en carrusel deslizable -->
  <div class="carrusel flex gap-3 overflow-x-auto snap-x snap-mandatory px-4 pt-6 pb-1 -mx-0">
    <% imagenes.forEach(img => { %>
      <img src="<%= img %>"
           class="w-[85%] sm:w-72 h-64 sm:h-72 object-cover rounded-2xl border border-dorado/30 snap-center shrink-0"
           alt="Foto del premio" loading="eager">
    <% }) %>
  </div>

  <!-- Barra de progreso -->
  <div class="max-w-2xl mx-auto mt-6 px-4">
    <div class="flex justify-between text-sm font-medium text-white/50 mb-1.5">
      <span>Vendido</span>
      <span class="text-dorado font-semibold"><%= porcentajeVendido %>%</span>
    </div>
    <div class="w-full bg-white/10 rounded-full h-3 overflow-hidden">
      <div class="bg-dorado h-3 rounded-full transition-all duration-700"
           style="width: <%= porcentajeVendido %>%"></div>
    </div>
  </div>

  <!-- Precio por número -->
  <div class="max-w-2xl mx-auto mt-8 px-4 text-center">
    <p class="text-white/50 text-sm">Valor por oportunidad</p>
    <p class="font-display text-3xl sm:text-4xl font-bold text-dorado mt-1">
      $<%= Number(rifa.precio_numero).toLocaleString('es-CO') %> 🇨🇴
    </p>
  </div>

  <!-- Paquetes de oportunidades -->
  <div id="paquetes" class="max-w-3xl mx-auto mt-6 px-4 scroll-mt-6">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-5 gap-y-4">
      <% paquetes.forEach(p => { %>
        <a href="/comprar/<%= rifa.id %>?cantidad=<%= p.cantidad %>"
           class="boleto-card block bg-tinta border border-dorado/30 hover:border-dorado rounded-xl p-4 text-center transition active:scale-[0.97]">
          <p class="font-display font-bold text-white"><%= p.cantidad %></p>
          <p class="text-xs text-white/50 -mt-0.5 mb-1">oportunidades</p>
          <p class="text-dorado font-semibold text-sm">$<%= p.precio %></p>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- Compra personalizada -->
  <div class="max-w-2xl mx-auto mt-8 px-4 text-center">
    <a href="/comprar/<%= rifa.id %>"
       class="inline-block bg-dorado text-tinta font-display font-semibold text-sm px-6 py-3 rounded-full hover:opacity-90 active:scale-[0.98] transition">
      Comprar cantidad personalizada
    </a>
  </div>

  <!-- Método de pago -->
  <div class="max-w-2xl mx-auto mt-6 px-4 text-center">
    <p class="text-xs uppercase tracking-wide text-white/40 mb-1">Pago</p>
    <p class="text-dorado font-semibold text-sm">WOMPI / NEQUI</p>
  </div>

  <!-- Buscar tus números -->
  <div class="max-w-2xl mx-auto mt-6 px-4 text-center">
    <a href="/numeros/<%= rifa.id %>" class="text-dorado text-sm font-medium underline underline-offset-2">
      🔍 Buscar tus números
    </a>
  </div>

</div>

<!-- Botón fijo inferior (solo celular) -->
<div class="fixed bottom-0 left-0 right-0 sm:hidden bg-tinta border-t border-dorado/30 p-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)]">
  <a href="#paquetes"
     class="block w-full text-center bg-dorado text-tinta font-display font-semibold py-3 rounded-xl active:scale-[0.98] transition">
    🎟️ Comprar oportunidades
  </a>
</div>