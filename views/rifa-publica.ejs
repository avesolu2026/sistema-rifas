<style>
  .carrusel::-webkit-scrollbar { display: none; }
  .carrusel { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="min-h-screen bg-tinta text-white pb-24 sm:pb-0">

  <!-- Navbar -->
  <nav class="border-b border-dorado/20 px-4 sm:px-8 py-4 flex items-center justify-between flex-wrap gap-3 overflow-x-hidden">
    <a href="#inicio" class="text-dorado font-display font-bold text-base sm:text-lg flex items-center gap-1 shrink-0">
      ★ PRISMA BY KEKU'S
    </a>
    <div class="hidden md:flex items-center gap-6 text-sm font-semibold uppercase tracking-wide text-white/80">
      <a href="#inicio" class="hover:text-dorado transition">Inicio</a>
      <a href="#paquetes" class="hover:text-dorado transition">Comprar stickers</a>
      <a href="#como-funciona" class="hover:text-dorado transition">Cómo funciona</a>
      <a href="#condiciones" class="hover:text-dorado transition">Condiciones</a>
      <a href="#contacto" class="hover:text-dorado transition">Contacto</a>
    </div>
    <a href="/numeros/<%= rifa.id %>"
       class="bg-dorado text-tinta font-display font-bold text-xs sm:text-sm px-3 sm:px-5 py-2 sm:py-2.5 rounded-full hover:opacity-90 transition shrink-0 whitespace-nowrap">
      Mis stickers
    </a>
  </nav>

  <!-- Hero: texto + foto -->
  <section id="inicio" class="grid md:grid-cols-2 gap-8 items-center px-4 sm:px-8 py-10 max-w-6xl mx-auto">
    <div>
      <p class="text-dorado text-xs uppercase tracking-widest font-semibold mb-2">Promoción especial</p>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold leading-tight mb-2">
        <%= rifa.titulo %><% if (rifa.subtitulo) { %><br><span class="text-dorado"><%= rifa.subtitulo %></span><% } %>
      </h1>
      <% if (rifa.detalle_corto) { %>
        <p class="text-white font-bold text-lg mb-3"><%= rifa.detalle_corto %></p>
      <% } %>
      <p class="text-white/70 text-base mb-6"><%= rifa.descripcion %></p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 border border-dorado/30 rounded-xl p-4 mb-6">
        <div>
          <p class="text-white/40 text-xs uppercase">Sorteo</p>
          <p class="font-display font-bold text-white">
            <%= new Date(rifa.fecha_sorteo).toLocaleDateString('es-CO', { day: 'numeric', month: 'long' }) %>
          </p>
        </div>
        <div>
          <p class="text-white/40 text-xs uppercase">Con la</p>
          <p class="font-display font-bold text-white"><%= rifa.loteria || 'Por definir' %></p>
        </div>
        <% if (rifa.nota_importante) { %>
        <div class="col-span-2 sm:col-span-1">
          <p class="text-white/40 text-xs uppercase">Importante</p>
          <p class="text-white/70 text-sm"><%= rifa.nota_importante %></p>
        </div>
        <% } %>
      </div>

      <a href="#paquetes"
         class="inline-block bg-dorado text-tinta font-display font-bold px-6 py-3 rounded-full hover:opacity-90 transition">
        Elegir mis stickers →
      </a>
    </div>

    <div class="relative max-w-lg mx-auto md:max-w-none">
      <div id="carrusel" class="carrusel flex gap-3 overflow-x-auto snap-x snap-mandatory">
        <% imagenes.forEach(img => { %>
          <img src="<%= img %>"
               class="w-full h-72 sm:h-96 object-cover rounded-2xl border border-dorado/30 snap-center shrink-0"
               alt="Foto del premio" loading="eager">
        <% }) %>
      </div>

      <% if (imagenes.length > 1) { %>
        <button onclick="moverCarrusel(-1)" class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/60 text-dorado w-9 h-9 rounded-full flex items-center justify-center hover:bg-black/80 transition">‹</button>
        <button onclick="moverCarrusel(1)" class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/60 text-dorado w-9 h-9 rounded-full flex items-center justify-center hover:bg-black/80 transition">›</button>

        <div class="flex justify-center gap-1.5 mt-3">
          <% imagenes.forEach((img, i) => { %>
            <span class="w-2 h-2 rounded-full bg-dorado/30"></span>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Progreso + precio -->
  <section class="max-w-2xl mx-auto px-4 mt-4">
    <p class="text-center text-xs text-dorado/80 font-semibold uppercase tracking-wide mb-3">
      🎫 Compra mínima: 5 stickers
    </p>
    <div class="flex justify-between text-sm font-medium text-white/50 mb-1.5">
      <span>Vendido</span>
      <span class="text-dorado font-semibold"><%= porcentajeVendido %>%</span>
    </div>
    <div class="w-full bg-white/10 rounded-full h-3 overflow-hidden">
      <div class="bg-dorado h-3 rounded-full transition-all duration-700"
           style="width: <%= porcentajeVendido %>%"></div>
    </div>

    <p class="text-center text-white/50 text-sm mt-8">Valor por sticker</p>
    <p class="text-center font-display text-3xl sm:text-4xl font-bold text-dorado mt-1">
      $<%= Number(rifa.precio_numero).toLocaleString('es-CO') %> 🇨🇴
    </p>
  </section>

  <!-- Paquetes -->
  <section id="paquetes" class="max-w-4xl mx-auto px-4 mt-8 scroll-mt-20">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
     <% paquetes.forEach(p => { %>
  <a href="/comprar/<%= rifa.id %>?cantidad=<%= p.cantidad %>"
     class="bg-black/20 border border-dorado/30 hover:border-dorado rounded-xl p-4 text-center transition active:scale-[0.97]">
    <p class="text-2xl mb-1">🎫</p>
    <p class="font-display font-bold text-white"><%= p.cantidad %></p>
    <p class="text-xs text-white/50 -mt-0.5 mb-1">stickers</p>
    <p class="text-dorado font-semibold text-sm">$<%= p.precio %></p>
  </a>
<% }) %>
    </div>

    <div class="text-center mt-8">
      <p class="font-display text-lg font-bold text-white mb-3">Si deseas más</p>
      <form action="/comprar/<%= rifa.id %>" method="GET" class="flex items-center justify-center gap-3">
        <input type="number" name="cantidad" min="1" value="1"
               class="w-20 text-center bg-white text-black rounded-lg px-3 py-2.5 font-semibold focus:outline-none focus:ring-2 focus:ring-dorado">
        <button type="submit"
                class="bg-green-500 text-white font-display font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-green-600 transition flex items-center gap-2">
          🛒 Comprar más stickers
        </button>
      </form>
    </div>

    <p class="text-center text-xs uppercase tracking-wide text-white/40 mt-6">Pago</p>
    <p class="text-center text-dorado font-semibold text-sm">WOMPI / NEQUI</p>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="max-w-4xl mx-auto px-4 py-16 scroll-mt-20">
    <p class="text-dorado text-xs uppercase tracking-widest font-semibold mb-2">Fácil y transparente</p>
    <h2 class="font-display text-3xl sm:text-4xl font-bold mb-8">¿Cómo participar?</h2>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="border border-dorado/30 rounded-xl p-5">
        <p class="text-dorado font-display font-bold text-sm mb-2">01</p>
        <p class="font-display font-bold mb-1">Elige</p>
        <p class="text-white/60 text-sm">Selecciona tus stickers.</p>
      </div>
      <div class="border border-dorado/30 rounded-xl p-5">
        <p class="text-dorado font-display font-bold text-sm mb-2">02</p>
        <p class="font-display font-bold mb-1">Regístrate</p>
        <p class="text-white/60 text-sm">Ingresa tus datos.</p>
      </div>
      <div class="border border-dorado/30 rounded-xl p-5">
        <p class="text-dorado font-display font-bold text-sm mb-2">03</p>
        <p class="font-display font-bold mb-1">Paga</p>
        <p class="text-white/60 text-sm">Realiza el pago habilitado.</p>
      </div>
    </div>
  </section>

  <!-- Condiciones -->
  <section id="condiciones" class="max-w-4xl mx-auto px-4 py-10 border-t border-dorado/20 scroll-mt-20">
    <h2 class="font-display text-3xl font-bold mb-6">Condiciones principales</h2>
    <ul class="space-y-3 text-white/70 text-sm list-disc list-inside">
      <li>Stickers disponibles: <%= rifa.total_numeros %>.</li>
      <li>Sorteo: <%= new Date(rifa.fecha_sorteo).toLocaleDateString('es-CO') %>.</li>
      <% if (rifa.nota_importante) { %><li><%= rifa.nota_importante %></li><% } %>
      <li>Antes de recibir pagos del público deben cumplirse las autorizaciones y condiciones legales aplicables.</li>
    </ul>
  </section>

    <!-- Contacto -->
  <section id="contacto" class="text-center py-16 px-4 border-t border-dorado/20">
    <h2 class="font-display text-3xl sm:text-4xl font-bold mb-4">¿Dudas?<br>Escríbenos</h2>
    <a href="https://wa.me/573104266914" target="_blank"
       class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-4 rounded-full text-lg transition active:scale-95 mt-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-white" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.549 4.107 1.51 5.833L.057 23.571a.5.5 0 0 0 .614.612l5.87-1.539A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.808 9.808 0 0 1-5.031-1.388l-.36-.214-3.733.979.997-3.648-.234-.374A9.817 9.817 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
      </svg>
      +57 310 4266914
    </a>
  </section>
  <!-- Buscar tus stickers -->
  <div class="text-center pb-10">
    <a href="/numeros/<%= rifa.id %>" class="text-dorado text-sm font-medium underline underline-offset-2">
      🔍 Buscar tus stickers
    </a>
  </div>

  <!-- Footer -->
  <footer class="bg-white border-t border-gray-200 px-4 py-12 mt-10">
    <div class="max-w-4xl mx-auto grid sm:grid-cols-2 gap-10">

      <div>
        <p class="font-display font-bold text-tinta text-2xl mb-3">★ PRISMA BY KEKU'S</p>
        <p class="text-sm text-gray-500 mb-1">Responsable</p>
        <p class="text-sm font-semibold text-tinta mb-4">Brihan Andrés Carabali</p>
        <a href="/terminos" class="inline-block text-sm text-boleto hover:text-tinta transition underline underline-offset-2 font-medium">
          Términos y Condiciones
        </a>
      </div>

      <div class="text-sm text-gray-600 space-y-3">
        <div class="flex items-start gap-2">
          <span class="text-dorado shrink-0">📍</span>
          <p>Calle 16 # 17-50, Barrio Centro, al lado de la Casa de la Cultura Municipal<br>Puerto Tejada, Cauca</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-dorado shrink-0">✉️</span>
          <a href="mailto:Brihan456-456@outlook.es" class="hover:text-tinta transition">Brihan456-456@outlook.es</a>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-dorado shrink-0">📱</span>
          <a href="https://wa.me/573104266914" target="_blank" class="hover:text-tinta transition">+57 310 4266914</a>
        </div>
      </div>

    </div>

    <div class="max-w-4xl mx-auto border-t border-gray-100 mt-8 pt-6">
      <p class="text-center text-xs text-gray-400">© PRISMA BY KEKU'S — Todos los derechos reservados</p>
    </div>
  </footer>

<!-- Botón fijo inferior (solo celular) -->
<div class="fixed bottom-0 left-0 right-0 sm:hidden bg-tinta border-t border-dorado/30 p-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)]">
  <a href="#paquetes"
     class="block w-full text-center bg-dorado text-tinta font-display font-semibold py-3 rounded-xl active:scale-[0.98] transition">
    🎟️ Comprar Stickers
  </a>
</div>

<script>
  function moverCarrusel(direccion) {
    const cont = document.getElementById('carrusel');
    cont.scrollBy({ left: direccion * cont.clientWidth, behavior: 'smooth' });
  }
</script>